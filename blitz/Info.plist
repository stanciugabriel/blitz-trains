<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Blitz connects to your local train services to show formation, live times, and platform changes.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.168.0.0/16</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>10.0.0.0/8</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>172.16.0.0/12</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>blitz</string>
			</array>
		</dict>
	</array>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Blitz uses your location during active train trips to detect boarding, station stops, and arrival, even when the app is in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Blitz uses your location to follow your train trip and detect boarding and arrival.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ro.openlabs.blitz.live-activity-start</string>
	</array>
</dict>
</plist>
